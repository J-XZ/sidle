[Distribution]
Distribution=ubuntu
Release=jammy

[Output]
Format=gpt_ext4
Output=root.img

[Boot]
Bootable=yes
KernelCommandLine=console=ttyS0
BootProtocols=bios
WithUnifiedKernelImages=no

[Content]
Packages=systemd
         linux-image-generic
         openssh-server
         ca-certificates
         build-essential
         cmake
         ninja-build
         git
         python3
         libnuma-dev
         numactl
         iproute2
         procps
ExtraTrees=rootfs
PostInstallationScript=mkosi.postinst

[Validation]
Password=root
